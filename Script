-- TAB 2: DIGGING & MINING
local DigTab = gui:tab{ Name = "Dig & Mine", Icon = "rbxassetid://6034996695" }

DigTab:slider({
    Name = "Dig Multiplier (Power)",
    Default = 2,
    Min = 1,
    Max = 50,
    Callback = function(val)
        digMultiplier = val
    end
})

DigTab:toggle({
    Name = "⚡ Turbo Auto Dig",
    Callback = function(state)
        turboDigEnabled = state
        if turboDigLoop then task.cancel(turboDigLoop) turboDigLoop = nil end
        if state then
            turboDigLoop = task.spawn(function()
                while turboDigEnabled do
                    if DigEvent then
                        for i = 1, digMultiplier do
                            DigEvent:FireServer()
                        end
                    end
                    task.wait(0.01)
                end
            end)
        end
    end
})

DigTab:toggle({
    Name = "🎯 Auto Aim Boulder",
    Callback = function(state)
        autoAimBoulder = state
    end
})

DigTab:toggle({
    Name = "💎 Auto Crystal Mine FX",
    Callback = function(state)
        crystalMineEnabled = state
        if promptCrystalConnection then promptCrystalConnection:Disconnect() promptCrystalConnection = nil end
        if state then
            promptCrystalConnection = ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
                if player == plr and CrystalEvent then
                    CrystalEvent:FireServer(prompt.Parent)
                end
            end)
        end
    end
})

