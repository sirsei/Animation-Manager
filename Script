local function OptimizePart(v)
    pcall(function()
        if v:IsA("Light") or v:IsA("PointLight") or v:IsA("SurfaceLight") or v:IsA("SpotLight") then
            if fpsBoostEnabled then 
                v.Enabled = false 
                v.Brightness = 0
                v.Range = 0
            end
        elseif v:IsA("BasePart") or v:IsA("MeshPart") then
            if v.Material == Enum.Material.Neon or fpsBoostEnabled then
                v.Material = Enum.Material.SmoothPlastic
            end
            v.CastShadow = false
            if v:IsA("MeshPart") then
                v.RenderFidelity = Enum.RenderFidelity.Performance
            end
        elseif v:IsA("Decal") or v:IsA("Texture") then
            if fpsBoostEnabled then v.Transparency = 1 end
        elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
            if fpsBoostEnabled then v.Enabled = false end
        elseif v:IsA("PostEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") or v:IsA("Clouds") then
            if fpsBoostEnabled then v.Enabled = false end
        end
    end)
end

local function ApplyFPSBoost(state)
    fpsBoostEnabled = state

    if state then
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 0
        pcall(function() Lighting.Technology = Enum.Technology.Compatibility end)

        for _, effect in ipairs(Lighting:GetChildren()) do
            pcall(function()
                if effect:IsA("PostEffect") or effect:IsA("BloomEffect") or effect:IsA("BlurEffect") or effect:IsA("SunRaysEffect") or effect:IsA("DepthOfFieldEffect") or effect:IsA("Light") or effect:IsA("Atmosphere") or effect:IsA("Clouds") then
                    effect.Enabled = false
                end
            end)
        end

        local camera = workspace.CurrentCamera
        if camera then
            for _, effect in ipairs(camera:GetChildren()) do
                pcall(function()
                    if effect:IsA("PostEffect") or effect:IsA("BloomEffect") then
                        effect.Enabled = false
                    end
                end)
            end
        end

        local childAddedLighting = Lighting.ChildAdded:Connect(function(child)
            if fpsBoostEnabled then
                pcall(function()
                    if child:IsA("Light") or child:IsA("PointLight") or child:IsA("SurfaceLight") or child:IsA("SpotLight") then
                        child.Enabled = false
                        child.Brightness = 0
                    elseif child:IsA("PostEffect") or child:IsA("BloomEffect") then
                        child.Enabled = false
                    end
                end)
            end
        end)
        table.insert(fpsConnections, childAddedLighting)

        for _, obj in ipairs(workspace:GetDescendants()) do
            OptimizePart(obj)
        end

        local workspaceAdded = workspace.DescendantAdded:Connect(function(obj)
            if fpsBoostEnabled then
                OptimizePart(obj)
            end
        end)
        table.insert(fpsConnections, workspaceAdded)

        lightSweepLoop = task.spawn(function()
            while fpsBoostEnabled do
                for _, light in ipairs(workspace:GetDescendants()) do
                    if light:IsA("Light") or light:IsA("PointLight") or light:IsA("SurfaceLight") or light:IsA("SpotLight") then
                        if light.Enabled or light.Brightness > 0 then
                            light.Enabled = false
                            light.Brightness = 0
                        end
                    end
                end
                task.wait(1)
            end
        end)

        if workspace.Terrain then
            pcall(function()
                workspace.Terrain.WaterWaveSize = 0
                workspace.Terrain.WaterWaveSpeed = 0
                workspace.Terrain.WaterReflectance = 0
                workspace.Terrain.WaterTransparency = 0
            end)
        end
    else
        for _, conn in ipairs(fpsConnections) do
            if conn then conn:Disconnect() end
        end
        table.clear(fpsConnections)

        if lightSweepLoop then
            task.cancel(lightSweepLoop)
            lightSweepLoop = nil
        end

        Lighting.GlobalShadows = originalLightingSettings.GlobalShadows
        Lighting.FogEnd = originalLightingSettings.FogEnd
        Lighting.Brightness = originalLightingSettings.Brightness
        pcall(function() Lighting.Technology = originalLightingSettings.Technology end)

        for _, effect in ipairs(Lighting:GetChildren()) do
            pcall(function()
                if effect:IsA("PostEffect") or effect:IsA("BloomEffect") or effect:IsA("BlurEffect") or effect:IsA("SunRaysEffect") or effect:IsA("DepthOfFieldEffect") or effect:IsA("Atmosphere") then
                    effect.Enabled = true
                end
            end)
        end
    end
end

