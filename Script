local function applyBoulderESP(boulder)
    if not boulder:IsA("Model") then return end

    for _, child in ipairs(boulder:GetDescendants()) do
        if child:IsA("BasePart") then
            child.Transparency = 0
            child:GetPropertyChangedSignal("Transparency"):Connect(function()
                if child.Transparency > 0 then
                    child.Transparency = 0
                end
            end)
        end
    end

    local highlight = voltiteHighlightCache[boulder] or boulder:FindFirstChild("BoulderESP")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "BoulderESP"
        highlight.FillColor = Color3.fromRGB(0, 255, 128)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.4
        highlight.OutlineTransparency = 0
        highlight.Adornee = boulder
        highlight.Parent = boulder
        voltiteHighlightCache[boulder] = highlight
    end
    highlight.Enabled = voltiteHighlightEnabled
end

