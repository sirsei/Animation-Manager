end)

local function TriggerPrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return end
    
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
    end)

    local fireFunc = fireproximityprompt or (typeof and typeof(fireproximityprompt) == "function" and fireproximityprompt)
    
    if fireFunc then
        pcall(function() fireFunc(prompt) end)
    else
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(0.001)
            prompt:InputHoldEnd()
        end)
    end
end

local function GetNearestPrompt()
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local nearestPrompt = nil
    local shortestDist = math.huge

    for i = #promptCache, 1, -1 do
        local prompt = promptCache[i]
        if not prompt or not prompt.Parent then
            table.remove(promptCache, i)
        elseif prompt.Enabled then
            local parent = prompt.Parent
            local pos = nil
            
            if parent:IsA("BasePart") then
                pos = parent.Position
            elseif parent:IsA("Model") then
                pos = parent.PrimaryPart and parent.PrimaryPart.Position or parent:GetPivot().Position
            elseif parent:IsA("Attachment") then
                pos = parent.WorldPosition
            end

            if pos then
                local dist = (hrp.Position - pos).Magnitude
                if dist <= prompt.MaxActivationDistance and dist < shortestDist then
                    shortestDist = dist
                    nearestPrompt = prompt
                end
            end
        end
    end
    return nearestPrompt
end

