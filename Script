        task.cancel(autoCollectLoop)
        autoCollectLoop = nil
    end

    if autoCollectPromptEnabled then
        autoCollectLoop = task.spawn(function()
            while autoCollectPromptEnabled do
                local nearest = GetNearestPrompt()
                if nearest then
                    TriggerPrompt(nearest)
                end
                task.wait(0.05)
            end
        end)

        gui:prompt{
            Title = "Auto Collect Prompt",
            Text = "Auto Collect Enabled [Q]",
            Time = 2
        }
    else
        gui:prompt{
            Title = "Auto Collect Prompt",
            Text = "Auto Collect Disabled [Q]",
            Time = 2
        }
    end

    if isKeybindTrigger and autoCollectToggleRef then
        pcall(function()
            autoCollectToggleRef:SetState(autoCollectPromptEnabled)
        end)
    end
end

